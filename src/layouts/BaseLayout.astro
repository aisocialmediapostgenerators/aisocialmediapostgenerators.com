---
import "../styles/global.css";
interface Props {
  title: string;
  description: string;
  canonical: string;
  structuredData?: Record<string, unknown>[];
}
const { title, description, canonical, structuredData = [] } = Astro.props;
const fullTitle = title === "Social Post AI" ? "Free AI Social Media Post Generator | Social Post AI" : `${title} | Social Post AI`;
const canonicalUrl = new URL(canonical, Astro.site);
const ogImage = new URL("/og.png", Astro.site);
const siteUrl = new URL("/", Astro.site).href;
const jsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": `${siteUrl}#organization`,
      name: "Social Post AI",
      url: siteUrl,
      logo: {
        "@type": "ImageObject",
        url: new URL("/icon-512.png", Astro.site).href,
        width: 512,
        height: 512,
      },
      email: "hi@aisocialmediapostgenerators.com",
    },
    {
      "@type": "WebSite",
      "@id": `${siteUrl}#website`,
      url: siteUrl,
      name: "Social Post AI",
      description: "Free tools for creating social media posts, captions, image concepts, videos, and Reels.",
      publisher: { "@id": `${siteUrl}#organization` },
      inLanguage: "en",
    },
    ...structuredData,
  ],
}).replace(/</g, "\\u003c");
---
<!doctype html>
<html lang="en"><head>
  <meta charset="UTF-8" /><meta name="viewport" content="width=device-width" /><meta name="generator" content={Astro.generator} />
  <meta name="theme-color" content="#ff6b4a" />
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
  <link rel="manifest" href="/site.webmanifest" />
  <title>{fullTitle}</title><meta name="description" content={description} /><link rel="canonical" href={canonicalUrl} />
  <meta property="og:type" content="website" /><meta property="og:site_name" content="Social Post AI" /><meta property="og:title" content={fullTitle} /><meta property="og:description" content={description} /><meta property="og:url" content={canonicalUrl} /><meta property="og:image" content={ogImage} /><meta property="og:image:width" content="1200" /><meta property="og:image:height" content="630" />
  <meta name="twitter:card" content="summary_large_image" /><meta name="twitter:title" content={fullTitle} /><meta name="twitter:description" content={description} /><meta name="twitter:image" content={ogImage} />
  <script type="application/ld+json" set:html={jsonLd} />
</head><body><slot /></body></html>
