---
import BaseLayout from "../layouts/BaseLayout.astro";
import BrandNav from "./BrandNav.astro";
import { companyPageList, type CompanyPage } from "../data/company-pages";
interface Props { page: CompanyPage }
const { page } = Astro.props;
const pageUrl = new URL(`/${page.slug}/`, Astro.site).href;
const siteUrl = new URL("/", Astro.site).href;
const pageType = page.slug === "about" ? "AboutPage" : page.slug === "contact" ? "ContactPage" : "WebPage";
const structuredData = [
  {
    "@type": pageType,
    "@id": `${pageUrl}#webpage`,
    url: pageUrl,
    name: page.title,
    description: page.description,
    dateModified: new Date(page.updated).toISOString().slice(0, 10),
    isPartOf: { "@id": `${siteUrl}#website` },
    author: { "@id": `${siteUrl}#organization` },
    inLanguage: "en",
  },
  {
    "@type": "BreadcrumbList",
    "@id": `${pageUrl}#breadcrumb`,
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: siteUrl },
      { "@type": "ListItem", position: 2, name: page.title, item: pageUrl },
    ],
  },
];
---
<BaseLayout title={page.title} description={page.description} canonical={`/${page.slug}/`} structuredData={structuredData}><main class="legal"><BrandNav back /><header class="legal-hero shell"><div><span class="kicker">{page.eyebrow}</span><h1>{page.title}</h1><p class="legal-intro">{page.description}</p><p class="updated">Last updated: {page.updated} · By the Social Post AI Editorial Team</p></div><aside aria-label="On this page"><b>On this page</b>{page.sections.map((section, index) => <a href={`#section-${index + 1}`}>{section.heading}</a>)}</aside></header><article class="legal-content shell"><div class="legal-main">{page.sections.map((section, index) => <section id={`section-${index + 1}`}><span class="section-index">0{index + 1}</span><h2>{section.heading}</h2>{section.paragraphs.map((paragraph) => <p>{paragraph}</p>)}{section.bullets && <ul>{section.bullets.map((bullet) => <li>{bullet}</li>)}</ul>}</section>)}</div><aside class="policy-links"><b>Trust & company</b>{companyPageList.map((item) => <a class={item.slug === page.slug ? "active" : ""} href={`/${item.slug}/`}>{item.title}<span>↗</span></a>)}</aside></article><footer class="legal-footer"><div class="shell"><p>Still have a question?</p><a href="mailto:hi@aisocialmediapostgenerators.com">hi@aisocialmediapostgenerators.com ↗</a></div></footer></main></BaseLayout>
